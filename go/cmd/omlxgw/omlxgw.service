# 用户服务示例：复制到 ~/.config/systemd/user/omlxgw.service 后
#   systemctl --user daemon-reload && systemctl --user enable --now omlxgw
[Unit]
Description=omlxgw - oMLX 并发与优先级网关
After=network-online.target

[Service]
ExecStart=%h/.local/bin/omlxgw -config %h/.config/omlxgw/config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
